# ============================================================================
# FieldFlow CRM — Production Environment
# ============================================================================
# Copy this to .env.production and fill in real values.
# chmod 600 .env.production (never commit this file!)
# ============================================================================

APP_NAME="FieldFlow CRM"
APP_ENV=production
APP_KEY=                    # Generate with: php artisan key:generate --force
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP  # Change to https://your-domain.com after SSL setup

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fieldflow
DB_USERNAME=fieldflow
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ------------------------------------------
# Cache & Session (database-backed — no Redis needed)
# ------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ------------------------------------------
# Session & Security
# ------------------------------------------
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

HASHING_DRIVER=bcrypt
BCRYPT_ROUNDS=12

# ------------------------------------------
# Logging
# ------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=error

# ------------------------------------------
# Mail (optional — for future email features)
# ------------------------------------------
MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------
# Filesystem
# ------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------
# Maintenance
# ------------------------------------------
APP_MAINTENANCE_DRIVER=file
